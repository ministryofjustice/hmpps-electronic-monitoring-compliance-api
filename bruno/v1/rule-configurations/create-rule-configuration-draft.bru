meta {
  name: Create rule configuration draft
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/rule-configurations/{{ruleConfigurationId}}/draft
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "parameters": {
      "threshold": 50
    }
  }
}

assert {
  res.status: eq 201
  res.body: isObject
}
